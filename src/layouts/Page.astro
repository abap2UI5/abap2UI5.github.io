---
/* The document around the page: head, a top line, a one-line foot. No
 * header - the page is a greeting and the tiles. The top line is the one
 * thing the two sites share: the wordmark and the two sites as tabs with
 * the current one marked. abap2UI5-addons.github.io has
 * the same line with the other tab current.
 *
 * THE POLICY. GitHub Pages sets no headers of ours, so the Content-Security-
 * Policy is a <meta>. The page runs no script at all - script-src is 'self',
 * no inline script, no handler attribute - and everything it loads is this
 * origin too. test/site.test.mjs holds the page to it. */
import "../styles/global.css";

interface Props { title: string; description: string }
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const CSP = [
  "default-src 'self'",
  "script-src 'self'",
  "style-src 'self'",
  "img-src 'self'",
  "font-src 'self'",
  "object-src 'none'",
  "base-uri 'self'",
  "form-action 'none'",
].join("; ");
---
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta http-equiv="Content-Security-Policy" content={CSP}>
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:image" content={new URL(`${base}logo.png`, Astro.site).href}>
<meta name="theme-color" content="#ffffff">
<link rel="icon" href={`${base}favicon.png`}>
<link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`}>
<link rel="preload" href={`${base}fonts/inter-roman-latin.woff2`} as="font" type="font/woff2" crossorigin>
</head>
<body>
<div class="topline wrap">
  <nav class="sites" aria-label="Sites">
    <a class="brand" href={base}><img src={`${base}logo.png`} alt="" width="22" height="22"> abap2UI5</a>
    <a href={base} aria-current="page">Home</a>
  </nav>
</div>
<main id="main">
  <slot />
</main>
<footer class="foot">
  <div class="wrap">
    <div class="foot-row">abap2UI5 · MIT licensed · <a href="mailto:contact@abap2UI5.org">contact@abap2UI5.org</a> · <a href="https://github.com/abap2UI5/abap2UI5.github.io">Edit this page</a></div>
  </div>
</footer>
</body>
</html>
