---
/* The entry page: a greeting, then the places a reader can go, in four
 * groups. Every tile leaves the page - this page explains nothing that the
 * docs, the why-site or a repository's README explains; it only points there.
 *
 * The tiles are data, so a new tool or add-on is one line here. A tile
 * marked `planned` has no address yet: the channel does not exist today and
 * the tile says so instead of linking into nothing. A tile marked `more` is
 * not one of the group's items but the way to all of them, and looks it. */
import Page from "../layouts/Page.astro";
import { MARKS } from "../components/marks";

type Tile = { href: string; title: string; text: string; planned?: boolean; more?: boolean; mark?: keyof typeof MARKS; for?: string };
type Group = { id: string; title: string; tiles: Tile[] };

const groups: Group[] = [
  {
    id: "introduction",
    title: "Introduction",
    tiles: [
      { href: "https://abap2ui5.github.io/why/", for: "For decision makers", title: "Why abap2UI5", text: "What it builds, who runs it, where it fits and where it does not, what it costs." },
      { href: "https://abap2ui5.github.io/docs/", for: "For developers", title: "Documentation", text: "Getting started, tutorial, cookbook, configuration, integration, the client API." },
      { href: "https://abap2ui5.github.io/docs/get_started/quickstart.html", title: "Quickstart", text: "Install with abapGit, create the HTTP service, run your first class." },
    ],
  },
  {
    id: "tools",
    title: "Tools",
    tiles: [
      { href: "https://abap2ui5.github.io/playground/", title: "Playground", text: "ABAP in the editor, the running app next to it. No server involved." },
      { href: "https://abap2ui5.github.io/playground/samples/", title: "Samples", text: "Searchable by control and UI5 release, most of them one click from running in the browser." },
      { href: "https://abap2ui5.github.io/playground/ai/", title: "AI Studio", text: "Describe an app, watch the class being written and fixed, download it for abapGit." },
      { href: "https://abap2ui5.github.io/layout-editor/", title: "Layout Editor", text: "Design a UI5 view by drag and drop, export one ABAP class." },
      { href: "https://abap2ui5-addons.github.io/abap-cloud-gui/#playground", title: "Report converter", text: "Paste a classic report, get a report class that runs on ABAP Cloud." },
    ],
  },
  {
    id: "addons",
    title: "Add-ons",
    tiles: [
      { href: "https://abap2ui5-addons.github.io/abap-cloud-gui/", title: "abap-cloud-gui", text: "Selection screens, WRITE lists, ALV grids and report events, on ABAP Cloud and 7.02." },
      { href: "https://abap2ui5-addons.github.io/rfc-connector/", title: "RFC Connector", text: "Run abap2UI5 apps from a remote system via RFC. An HTTP variant exists too." },
      { href: "https://abap2ui5-addons.github.io/launchpad-kpi/", title: "Launchpad KPI", text: "KPIs of abap2UI5 apps as tiles on the Fiori Launchpad." },
      { href: "https://abap2ui5-addons.github.io/sql-console/", title: "SQL Console", text: "Run SQL in the browser." },
      { href: "https://abap2ui5-addons.github.io/sapgui/", title: "SAP GUI in the browser", text: "Classic transactions rebuilt as abap2UI5 apps, with se16n and table maintenance beside it." },
      { href: "https://abap2ui5-addons.github.io/admin-cockpit/", title: "Admin Cockpit", text: "Usage, errors, performance and a security traffic light for your installation." },
      { href: "https://abap2ui5-addons.github.io/", title: "All add-ons", text: "The overview of every add-on, with a page for each.", more: true },
    ],
  },
  {
    id: "community",
    title: "Community",
    tiles: [
      { href: "https://github.com/abap2UI5", mark: "github", title: "GitHub", text: "Source, issues and pull requests. Two organizations, the framework and the add-ons." },
      { href: "https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email", mark: "slack", title: "Slack", text: "The abap2UI5 channel in the abapGit workspace. The fastest answer." },
      { href: "https://www.linkedin.com/company/abap2ui5", mark: "linkedin", title: "LinkedIn", text: "Releases, blog posts, community highlights." },
      { href: "https://community.sap.com/", mark: "community", title: "SAP Community", text: "Blog posts and questions on community.sap.com.", planned: true },
      { href: "https://bsky.app/", mark: "bluesky", title: "Bluesky", text: "Short updates and release announcements.", planned: true },
    ],
  },
];
const base = import.meta.env.BASE_URL;
---
<Page title="abap2UI5 — Build UI5 Apps Purely in ABAP" description="Welcome to abap2UI5: the documentation, the playground and the browser tools, the development tools, the add-ons and where the community meets." >

<div class="wrap">
  <h1 class="welcome"><img src={`${base}logo.png`} alt="" width="40" height="40"> Welcome to abap2UI5</h1>

  {groups.map((g) => (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="tiles">
        {g.tiles.map((t) => (
          <li>
            <a class:list={["tile", { planned: t.planned, more: t.more }]} href={t.href}>
              {t.for && <span class="for">{t.for}</span>}
              <strong>{t.mark && <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" set:html={MARKS[t.mark]} />}{t.title}{t.planned && <span class="tag">coming</span>}</strong>
              <span class="text">{t.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

</Page>
