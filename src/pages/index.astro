---
/* The entry page: a greeting, then the places a reader can go, in five
 * groups. Every tile leaves the page - this page explains nothing that the
 * docs, the why-site or a repository's README explains; it only points there.
 *
 * The tiles are data, so a new tool or add-on is one line here. A tile
 * marked `planned` has no address yet: the channel does not exist today and
 * the tile says so instead of linking into nothing. */
import Page from "../layouts/Page.astro";

type Tile = { href: string; title: string; text: string; planned?: boolean };
type Group = { id: string; title: string; tiles: Tile[] };

const groups: Group[] = [
  {
    id: "introduction",
    title: "Introduction",
    tiles: [
      { href: "https://abap2ui5.github.io/why/", title: "Why abap2UI5", text: "What it builds, who runs it, where it fits and where it does not, what it costs." },
      { href: "https://abap2ui5.github.io/docs/", title: "Documentation", text: "Getting started, tutorial, cookbook, configuration, integration, the client API." },
      { href: "https://abap2ui5.github.io/docs/get_started/quickstart.html", title: "Quickstart", text: "Install with abapGit, create the HTTP service, run your first class." },
    ],
  },
  {
    id: "tools-browser",
    title: "Tools · browser based",
    tiles: [
      { href: "https://abap2ui5.github.io/playground/", title: "Playground", text: "ABAP in the editor, the running app next to it. No server involved." },
      { href: "https://abap2ui5.github.io/playground/samples/", title: "Samples", text: "Searchable by control and UI5 release, most of them one click from running in the browser." },
      { href: "https://abap2ui5.github.io/playground/ai/", title: "AI Studio", text: "Describe an app, watch the class being written and fixed, download it for abapGit." },
      { href: "https://abap2ui5.github.io/layout-editor/", title: "Layout Editor", text: "Design a UI5 view by drag and drop, export one ABAP class." },
      { href: "https://abap2ui5-addons.github.io/abap-cloud-gui/#playground", title: "Report converter", text: "Paste a classic report, get a report class that runs on ABAP Cloud." },
    ],
  },
  {
    id: "tools-development",
    title: "Tools · development process",
    tiles: [
      { href: "https://abap2ui5.github.io/docs/advanced/linter.html", title: "Linter", text: "Static and headless-render checks over an app class and its view, without an SAP system." },
      { href: "https://github.com/abap2UI5/vscode-extension", title: "VS Code Extension", text: "Lints while you type, runs a class against a real system, registers the MCP servers." },
      { href: "https://github.com/abap2UI5/mcp-server", title: "MCP Server", text: "An agent searches the samples, validates, deploys, runs and screenshots an app." },
      { href: "https://github.com/abap2UI5/app-template", title: "App Template", text: "Starter repository for an app project: example app, linting and CI preconfigured." },
      { href: "https://github.com/abap2UI5/headless-frontend", title: "Headless Frontend", text: "Drive and test apps from ABAP. No browser, no UI5, no HTTP." },
      { href: "https://github.com/abap2UI5/embed-control", title: "Embed Control", text: "Run an app inside your own UI5 app, Fiori elements page or Work Zone card." },
    ],
  },
  {
    id: "addons",
    title: "Add-ons",
    tiles: [
      { href: "https://github.com/abap2UI5-addons/abap-cloud-gui", title: "abap-cloud-gui", text: "Selection screens, WRITE lists, ALV grids and report events, on ABAP Cloud and 7.02." },
      { href: "https://github.com/abap2UI5-addons/rfc-connector", title: "RFC Connector", text: "Run abap2UI5 apps from a remote system via RFC. An HTTP variant exists too." },
      { href: "https://github.com/abap2UI5-addons/launchpad-kpi", title: "Launchpad KPI", text: "KPIs of abap2UI5 apps as tiles on the Fiori Launchpad." },
      { href: "https://github.com/abap2UI5-addons/sql-console", title: "SQL Console", text: "Run SQL in the browser." },
      { href: "https://github.com/abap2UI5-addons/sapgui", title: "SAP GUI in the browser", text: "Classic transactions rebuilt as abap2UI5 apps, with se16n and table maintenance beside it." },
      { href: "https://github.com/abap2UI5-addons/admin-cockpit", title: "Admin Cockpit", text: "Usage, errors, performance and a security traffic light for your installation." },
    ],
  },
  {
    id: "community",
    title: "Community",
    tiles: [
      { href: "https://github.com/abap2UI5", title: "GitHub", text: "Source, issues and pull requests. Two organizations, the framework and the add-ons." },
      { href: "https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email", title: "Slack", text: "The abap2UI5 channel in the abapGit workspace. The fastest answer." },
      { href: "https://www.linkedin.com/company/abap2ui5", title: "LinkedIn", text: "Releases, blog posts, community highlights." },
      { href: "https://community.sap.com/", title: "SAP Community", text: "Blog posts and questions on community.sap.com.", planned: true },
      { href: "https://bsky.app/", title: "Bluesky", text: "Short updates and release announcements.", planned: true },
      { href: "mailto:contact@abap2UI5.org", title: "Contact", text: "contact@abap2UI5.org. Commercial support on request." },
    ],
  },
];
const base = import.meta.env.BASE_URL;
---
<Page title="abap2UI5 — Build UI5 Apps Purely in ABAP" description="Welcome to abap2UI5: the documentation, the playground and the browser tools, the development tools, the add-ons and where the community meets." >

<div class="wrap">
  <h1 class="welcome"><img src={`${base}logo.png`} alt="" width="40" height="40"> Welcome to abap2UI5</h1>

  {groups.map((g) => (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="tiles">
        {g.tiles.map((t) => (
          <li>
            <a class:list={["tile", { planned: t.planned }]} href={t.href}>
              <strong>{t.title}{t.planned && <span class="tag">coming</span>}</strong>
              <span class="text">{t.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

</Page>
