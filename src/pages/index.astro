---
/* The entry page: a greeting, then the places a reader can go, in four
 * groups. Every tile leaves the page - this page explains nothing that the
 * docs, the why-site or a repository's README explains; it only points there.
 *
 * The tiles are data, so a new tool or add-on is one line here. SAP Community and Bluesky
 * have no abap2UI5 channel yet; their tiles lead to the platform until
 * there is one. The add-ons group is one tile:
 * the add-ons live on their own site, abap2ui5-addons.github.io. */
import Page from "../layouts/Page.astro";
import { MARKS } from "../components/marks";

type Tile = { href: string; title: string; text: string; mark?: keyof typeof MARKS; for?: string };
type Group = { id: string; title: string; tiles: Tile[] };

const groups: Group[] = [
  {
    id: "introduction",
    title: "Introduction",
    tiles: [
      { href: "https://abap2ui5.github.io/why/", for: "For decision makers", title: "What is abap2UI5?", text: "UI5 apps written entirely in ABAP: what that means for your team, your landscape and your budget, and where it fits." },
      { href: "https://abap2ui5.github.io/docs/", for: "For developers", title: "Technical Documentation", text: "How it works, how to install it and how to build apps: tutorial, cookbook, configuration, client API." },
    ],
  },
  {
    id: "tools",
    title: "Tools",
    tiles: [
      { href: "https://abap2ui5.github.io/playground/", title: "Playground", text: "ABAP in the editor, the running app next to it. No server involved." },
      { href: "https://abap2ui5.github.io/playground/samples/", title: "Samples", text: "Searchable by control and UI5 release, most of them one click from running in the browser." },
      { href: "https://abap2ui5.github.io/playground/ai/", title: "AI Studio", text: "Describe an app, watch the class being written and fixed, download it for abapGit." },
      { href: "https://abap2ui5.github.io/layout-editor/", title: "Layout Editor", text: "Design a UI5 view by drag and drop, export one ABAP class." },
      { href: "https://abap2ui5-addons.github.io/abap-cloud-gui/#playground", title: "Report converter", text: "Paste a classic report, get a report class that runs on ABAP Cloud." },
    ],
  },
  {
    id: "community",
    title: "Community",
    tiles: [
      { href: "https://github.com/abap2UI5", mark: "github", title: "GitHub", text: "Source, issues and pull requests. Two organizations, the framework and the add-ons." },
      { href: "https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email", mark: "slack", title: "Slack", text: "The abap2UI5 channel in the abapGit workspace. The fastest answer." },
      { href: "https://www.linkedin.com/company/abap2ui5", mark: "linkedin", title: "LinkedIn", text: "Releases, blog posts, community highlights." },
      { href: "https://community.sap.com/", mark: "community", title: "SAP Community", text: "Blog posts and questions on community.sap.com." },
      { href: "https://bsky.app/", mark: "bluesky", title: "Bluesky", text: "Short updates and release announcements." },
    ],
  },
  {
    id: "addons",
    title: "Add-ons",
    tiles: [
      { href: "https://abap2ui5-addons.github.io/", title: "More", text: "Every add-on of abap2UI5, with a page for each: classic ABAP on the web, connectors, app infrastructure, custom controls and the developer tools." },
    ],
  },
];
const base = import.meta.env.BASE_URL;
---
<Page title="abap2UI5 — Build UI5 Apps Purely in ABAP" description="Welcome to abap2UI5: the documentation, the playground and the browser tools, the development tools, the add-ons and where the community meets." >

<div class="wrap">
  <h1 class="welcome"><img src={`${base}logo.png`} alt="" width="40" height="40"> Welcome to abap2UI5</h1>

  {groups.map((g) => (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="tiles">
        {g.tiles.map((t) => (
          <li>
            <a class="tile" href={t.href}>
              {t.for && <span class="for">{t.for}</span>}
              <strong>{t.mark && <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" set:html={MARKS[t.mark]} />}{t.title}</strong>
              <span class="text">{t.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

</Page>
