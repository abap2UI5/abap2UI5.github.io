---
/* The entry page: a greeting, then the places a reader can go, in four
 * groups. Every tile leaves the page - this page explains nothing that the
 * docs, the why-site or a repository's README explains; it only points there.
 *
 * The tiles are data, so a new tool or addon is one line here. SAP Community and Bluesky
 * have no abap2UI5 channel yet; their tiles lead to the platform until
 * there is one. Every tile opens in a new tab - the
 * page is a signpost and stays open - except the ones marked `inside`, which
 * lead to the two sister sites, Samples and Addons & Tools, whose top line
 * leads back here by its Home tab: they open in the same tab and carry a
 * straight arrow. The addons and the developer
 * tools live on their own site, abap2ui5-addons.github.io: the "More" tile
 * and the second tab of the top line lead there. */
import Page from "../layouts/Page.astro";
import { MARKS } from "../components/marks";

type Tile = { href: string; title: string; text?: string; mark?: keyof typeof MARKS; for?: string; inside?: boolean };
type Group = { id: string; title: string; tiles: Tile[] };

const groups: Group[] = [
  {
    id: "introduction",
    title: "Introduction",
    tiles: [
      { href: "https://abap2ui5.github.io/why/", for: "For managers", title: "What is abap2UI5?", text: "The business view: what it means for your team, landscape and budget." },
      { href: "https://abap2ui5.github.io/docs/", for: "For developers", title: "How does it work?", text: "The technical view: how it works, how to install it, how to build apps." },
    ],
  },
  {
    id: "try-it",
    title: "Try it online",
    tiles: [
      { href: "https://abap2ui5.github.io/playground/", title: "Playground", text: "Write ABAP in the browser and watch the app run beside it. No SAP system needed." },
      { href: "https://abap2ui5.github.io/layout-editor/", title: "Layout Editor", text: "Design a UI5 View by Drag & Drop, then export it as an ABAP class." },
      { href: "https://abap2ui5.github.io/playground/ai/", title: "AI App Builder", text: "Describe the app you need. The AI writes it; you download it for abapGit." },
      { href: "https://abap2ui5.github.io/playground/pilot/", title: "AI Agent", text: "Let the AI operate a running app. Describe the task in the chat and watch it work." },
      { href: "https://abap2ui5-addons.github.io/abap-cloud-gui/#playground", title: "Report Converter", text: "Paste a classic report and get back a class that runs on ABAP Cloud." },
    ],
  },
  {
    id: "more",
    title: "More",
    tiles: [
      { href: "https://abap2ui5.github.io/samples-site/", title: "Samples", text: "Hundreds of ready-to-run apps, by control and UI5 release.", inside: true },
      { href: "https://abap2ui5-addons.github.io/", title: "Addons & Tools", text: "Addons for your system, tools for your editor and pipeline, each with a page.", inside: true },
    ],
  },
  {
    id: "community",
    title: "Community",
    tiles: [
      { href: "https://github.com/abap2UI5", mark: "github", title: "GitHub" },
      { href: "https://abapgit.slack.com/join/shared_invite/zt-46tqufaht-QlrxTzlDqlx85CWbeUnOqg#/shared-invite/email", mark: "slack", title: "Slack" },
      { href: "https://www.linkedin.com/company/abap2ui5", mark: "linkedin", title: "LinkedIn" },
      { href: "https://community.sap.com/", mark: "community", title: "SAP SCN" },
      { href: "https://bsky.app/", mark: "bluesky", title: "Bluesky" },
    ],
  },
];
const base = import.meta.env.BASE_URL;
---
<Page title="abap2UI5" description="Welcome to abap2UI5: the documentation, the playground and the browser tools, the development tools, the addons and where the community meets." >

<div class="wrap">
  <h1 class="welcome">Welcome to abap2UI5 <img src={`${base}logo.png`} alt="" width="76" height="76"></h1>

  {groups.map((g) => g.id === "community" ? (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="links">
        {g.tiles.map((t) => (
          <li><a href={t.href} target="_blank" rel="noopener">{t.mark && <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" set:html={MARKS[t.mark]} />}{t.title}</a></li>
        ))}
      </ul>
    </section>
  ) : (
    <section class="group" id={g.id}>
      <h2>{g.title}</h2>
      <ul class="tiles">
        {g.tiles.map((t) => (
          <li>
            <a class:list={["tile", { inside: t.inside }]} href={t.href} target={t.inside ? undefined : "_blank"} rel={t.inside ? undefined : "noopener"}>
              {t.for && <span class="for">{t.for}</span>}
              <strong>{t.title}</strong>
              <span class="text">{t.text}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  ))}
</div>

</Page>
